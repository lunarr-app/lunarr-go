# shellcheck disable=SC2034,SC2148

# If unset, Lunarr generates a secret on first run and persists it to
# <LUNARR_DATA_DIR>/auth-secret for reuse on later starts. Set this to pin a
# stable value across environments. It must be at least 32 characters.
#
# IMPORTANT: AUTH_SECRET is used for more than login sessions. It derives the
# key that encrypts stored secrets (API keys, share/device tokens) and signs
# remote playback URLs (Cast, AirPlay, HLS, subtitles). Changing it after
# startup invalidates every existing session, encrypted secret, and signed
# playback token, so keep it stable between restarts and across all instances
# that share the same data directory.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-chars

# Public URL where the app is accessed. Must match the URL users open in the
# browser. If it is wrong, login, sessions, and remote/signed playback URLs fail.
ORIGIN=http://127.0.0.1:5173

# Persistent app data directory. The SQLite database, the generated auth-secret
# file, per-session HLS playlists, and shared HLS cache segments are stored
# here. Back up this directory to preserve your data and the persisted secret.
LUNARR_DATA_DIR=.lunarr

# Optional library watcher tuning. Enable polling for remote/network mounts where native file events are unreliable.
LUNARR_WATCH_USE_POLLING=false
LUNARR_WATCH_INTERVAL_MS=5000
LUNARR_WATCH_BINARY_INTERVAL_MS=10000
LUNARR_WATCH_DEBOUNCE_MS=5000
LUNARR_WATCH_WRITE_STABILITY_MS=10000

# Optional signed playback token lifetime for Cast, AirPlay, and native clients, in seconds. Default: 28800 (8 hours).
# LUNARR_SIGNED_PLAYBACK_TOKEN_TTL_SECONDS=28800

# Optional paired device API key lifetime in days. Default: 730 (2 years). Use 0 for no expiry.
# LUNARR_DEVICE_PAIRING_API_KEY_EXPIRES_IN_DAYS=730

# Optional FFmpeg binary path. Defaults to the system `ffmpeg` on PATH. Set this if FFmpeg is in a non-standard location or you want to pin a build.
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# Optional VAAPI render device for hardware transcoding on Linux. Defaults to
# /dev/dri/renderD128. Change it if your GPU exposes a different device node.
# FFMPEG_VAAPI_DEVICE=/dev/dri/renderD128

# Optional adapter-node bind settings used when running `bun run start`. HOST is
# the listen interface and PORT is the TCP port.
# HOST=127.0.0.1
# PORT=3000

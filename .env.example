# shellcheck disable=SC2034,SC2148

# Required for production and recommended for local development.
# Keep this value stable between restarts. It must be at least 32 characters.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-chars

# Public URL where the app is accessed.
ORIGIN=http://127.0.0.1:5173

# Persistent app data directory. SQLite database files are stored here.
LUNARR_DATA_DIR=.lunarr

# Optional library watcher tuning. Enable polling for remote/network mounts where native file events are unreliable.
LUNARR_WATCH_USE_POLLING=false
LUNARR_WATCH_INTERVAL_MS=5000
LUNARR_WATCH_BINARY_INTERVAL_MS=10000
LUNARR_WATCH_DEBOUNCE_MS=5000
LUNARR_WATCH_WRITE_STABILITY_MS=10000

# Optional adapter-node bind settings for `bun run start`.
# HOST=127.0.0.1
# PORT=3000

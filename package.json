{
  "name": "lunarr",
  "private": true,
  "version": "0.10.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "start": "NODE_ENV=production node scripts/start.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "verify:ffmpeg": "node scripts/verify-ffmpeg.mjs",
    "verify:nodeav": "node scripts/verify-nodeav-probe.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "smoke:transcode": "node scripts/smoke-ffmpeg-transcode.mjs",
    "smoke:hardware": "node scripts/smoke-ffmpeg-hardware.mjs",
    "smoke:browser:seek": "node scripts/browser-hls-seek-smoke.mjs",
    "smoke:browser:player": "node scripts/browser-custom-player-smoke.mjs",
    "seed:radarr": "node scripts/seed-radarr-movies.mjs",
    "seed:demo": "node scripts/seed-demo-collection.mjs",
    "verify:tmdb": "node scripts/verify-tmdb.mjs"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.10",
    "@lucide/svelte": "1.57.0",
    "better-auth": "1.7.10",
    "chokidar": "5.0.0",
    "guessit-js": "4.0.0",
    "hls.js": "1.7.3",
    "kysely": "0.29.6",
    "libsql": "0.5.29",
    "node-av": "6.1.1",
    "ssh2": "1.17.0",
    "theintrodb": "4.0.0",
    "webdav": "5.11.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/bun": "1.4.3",
    "@types/node": "24.19.2",
    "@types/ssh2": "1.15.6",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "overrides": {
